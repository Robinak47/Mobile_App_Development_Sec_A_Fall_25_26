<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <EditText
        android:id="@+id/nameTF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginBottom="38dp"
        android:ems="10"
        android:hint="input your name"
        android:inputType="text"
        app:layout_constraintBottom_toTopOf="@+id/emailTF"
        app:layout_constraintStart_toStartOf="@+id/emailTF" />

    <EditText
        android:id="@+id/emailTF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="197dp"
        android:ems="10"
        android:hint="input your email"
        android:inputType="textEmailAddress"
        app:layout_constraintEnd_toEndOf="@+id/phoneTF"
        app:layout_constraintStart_toStartOf="@+id/phoneTF"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/phoneTF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="55dp"
        android:layout_marginTop="52dp"
        android:ems="10"
        android:hint="input your phoneNo"
        android:inputType="phone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emailTF" />

    <Button
        android:id="@+id/btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="93dp"
        android:layout_marginTop="69dp"
        android:text="submit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phoneTF" />
</androidx.constraintlayout.widget.ConstraintLayout>